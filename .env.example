# Copy to .env.local. Every variable is optional — the app works without any of them.

# --- Optional language-model help for understanding free-text requests ---
# The rule-based parser always runs first. A model is only asked to fill fields
# the rules couldn't find, and its output is validated like any other input.
#
# Which helper to use: "ollama", "anthropic" or "none".
# Unset = Claude if ANTHROPIC_API_KEY is set, else Ollama if OLLAMA_MODEL is set.
LLM_PROVIDER=

# Local model via Ollama (no API key; nothing leaves your machine).
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Claude via the Anthropic API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Live lookups ---
# Set to "1" to skip Wikipedia and Open-Meteo (offline demos or CI).
# The UI then labels those sections as unavailable instead of pretending.
WAYFARE_OFFLINE=
