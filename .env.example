# Copy to .env.local. Every variable is optional — the app works without any of them.

# Enables Claude-assisted request understanding on the server. Without it,
# the deterministic rule-based parser handles every request.
ANTHROPIC_API_KEY=

# Override the Claude model used for request understanding.
ANTHROPIC_MODEL=claude-haiku-4-5

# Set to "1" to skip live lookups (Wikipedia, Open-Meteo) — useful offline or in CI.
# The UI then labels those sections as unavailable instead of pretending.
WAYFARE_OFFLINE=
